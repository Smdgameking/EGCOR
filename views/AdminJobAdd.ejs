
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta
name="viewport"
content="width=device-width, initial-scale=1.0">

<title>
Manage Jobs
</title>

<style>

*{
    margin:0;
    padding:0;
    box-sizing:border-box;
    font-family:Arial,sans-serif;
}

body{
    background:#f1f5f9;
    color:#111827;
}

.container{
    display:flex;
    min-height:100vh;
}

/* SIDEBAR */

.sidebar{
    width:280px;
    background:
    linear-gradient(
        180deg,
        #1e3a8a,
        #2563eb
    );

    color:white;

    padding:25px;

    position:sticky;
    top:0;

    height:100vh;
}

.logo{
    display:flex;
    align-items:center;
    gap:12px;
    margin-bottom:40px;
}

.logo-icon{
    width:50px;
    height:50px;
    border-radius:14px;

    background:
    rgba(255,255,255,0.15);

    display:flex;
    justify-content:center;
    align-items:center;

    font-size:24px;
}

.logo h2{
    font-size:22px;
}

.sidebar-links{
    display:flex;
    flex-direction:column;
    gap:14px;
}

.sidebar-links a{
    text-decoration:none;
    color:white;

    padding:14px 16px;

    border-radius:12px;

    transition:0.3s;

    font-weight:bold;
}

.sidebar-links a:hover,
.active-link{
    background:
    rgba(255,255,255,0.18);
}

/* MAIN */

.main{
    flex:1;
    padding:30px;
}

/* HEADER */

.topbar{
    display:flex;
    justify-content:space-between;
    align-items:center;
    flex-wrap:wrap;
    gap:20px;

    margin-bottom:30px;
}

.topbar h1{
    font-size:34px;
    margin-bottom:8px;
}

.topbar p{
    color:#64748b;
}

.add-btn{
    border:none;

    background:
    linear-gradient(
        135deg,
        #2563eb,
        #1d4ed8
    );

    color:white;

    padding:14px 20px;

    border-radius:12px;

    cursor:pointer;

    font-size:15px;

    font-weight:bold;

    text-decoration:none;
}

/* JOB FORM */

.job-form-box{
    background:white;

    border-radius:24px;

    padding:30px;

    box-shadow:
    0 4px 15px rgba(0,0,0,0.06);

    margin-bottom:40px;
}

.section-title{
    font-size:28px;
    margin-bottom:20px;
}

.job-form{
    display:grid;

    grid-template-columns:
    repeat(auto-fit,minmax(300px,1fr));

    gap:20px;
}

.form-group{
    display:flex;
    flex-direction:column;
}

.full-width{
    grid-column:1/-1;
}

.form-group label{
    margin-bottom:8px;
    font-weight:bold;
}

.form-group input,
.form-group textarea,
.form-group select{

    padding:14px;

    border-radius:12px;

    border:1px solid #d1d5db;

    background:#f8fafc;

    outline:none;
}

.form-group textarea{
    resize:none;
    height:130px;
}

.submit-btn{

    margin-top:10px;

    border:none;

    background:
    linear-gradient(
        135deg,
        #2563eb,
        #1d4ed8
    );

    color:white;

    padding:15px;

    border-radius:14px;

    cursor:pointer;

    font-size:16px;

    font-weight:bold;
}

/* JOBS TABLE */

.table-box{
    background:white;

    border-radius:24px;

    padding:25px;

    box-shadow:
    0 4px 15px rgba(0,0,0,0.06);

    overflow-x:auto;
}

.table-header{
    display:flex;
    justify-content:space-between;
    align-items:center;
    gap:20px;
    flex-wrap:wrap;

    margin-bottom:20px;
}

.search-box{
    padding:12px 16px;

    border-radius:12px;

    border:1px solid #d1d5db;

    width:280px;
}

.table{
    width:100%;
    border-collapse:collapse;
}

.table th,
.table td{

    padding:16px;

    border-bottom:1px solid #e5e7eb;

    text-align:left;
}

.table th{
    background:#f8fafc;
}

.status{
    padding:8px 14px;

    border-radius:20px;

    font-size:13px;

    font-weight:bold;
}

.active{
    background:#bbf7d0;
    color:#166534;
}

.closed{
    background:#fecaca;
    color:#991b1b;
}

.action-buttons{
    display:flex;
    gap:10px;
    flex-wrap:wrap;
}

.edit-btn,
.delete-btn{

    border:none;

    padding:10px 14px;

    border-radius:10px;

    cursor:pointer;

    font-weight:bold;
}

.edit-btn{
    background:#dbeafe;
    color:#1d4ed8;
}

.delete-btn{
    background:#fee2e2;
    color:#dc2626;
}

/* RESPONSIVE */

@media(max-width:1000px){

    .container{
        flex-direction:column;
    }

    .sidebar{
        width:100%;
        height:auto;
        position:relative;
    }

}

@media(max-width:700px){

    .main{
        padding:18px;
    }

    .topbar h1{
        font-size:28px;
    }

}

</style>
</head>
<body>

<div class="container">


<!-- SIDEBAR -->

<div class="sidebar">

    <div class="logo">

        <div class="logo-icon">
            🏛️
        </div>

        <h2>
            Admin Panel
        </h2>

    </div>


    <div class="sidebar-links">

        <a href="/admin/dashboard">
            📊 Dashboard
        </a>

        <a
        href="/admin/jobs"
        class="active-link">

            💼 Jobs

        </a>


        <a href="/admin/applications">
            📄 Applications
        </a>

        <a href="/logout">
            🚪 Logout
        </a>

    </div>

</div>



<!-- MAIN -->

<div class="main">


<!-- TOPBAR -->

<div class="topbar">

    <div>

        <h1>
            Manage Jobs 💼
        </h1>

        <p>
            Create, edit and manage recruitment jobs.
        </p>

    </div>

    <a
        href="/admin/jobadd"
        class="add-btn">

        ➕ Add Job

    </a>

</div>




<!-- JOBS TABLE -->

<div class="table-box">


    <div class="table-header">

        <h2>
            Published Jobs
        </h2>


        <input
        type="text"
        class="search-box"
        placeholder="Search jobs...">

    </div>



    <table class="table">

        <thead>

            <tr>

                <th>
                    Title
                </th>

                <th>
                    Qualification
                </th>

                <th>
                    Location
                </th>

                <th>
                    Last Date
                </th>

                <th>
                    Status
                </th>

                <th>
                    Actions
                </th>

            </tr>

        </thead>


        <tbody>

            <% jobs.forEach(job => { %>

            <tr>

                <td>
                    <%= job.title %>
                </td>

                <td>
                    <%= job.qualification %>
                </td>

                <td>
                    <%= job.location %>
                </td>

                <td>
                    <%= job.lastDate %>
                </td>

                <td>

                    <span
                    class="status <%= job.status.toLowerCase() %>">

                        <%= job.status %>

                    </span>

                </td>

                <td>

                    <div class="action-buttons">
                        <a href="/admin/jobedit/<%= job._id %>">
                        <button class="edit-btn">

                            Edit

                            </button>
                        </a>

                        <a href="/admin/jobdelete/<%= job._id %>">
                        <button class="delete-btn">

                            Delete

                        </button>
                        </a>

                    </div>

                </td>

            </tr>

            <% }) %>

        </tbody>

    </table>

</div>


</div>

</div>

</body>
</html>