/* ================= EXPERIENCED COMPANIES ================= */

const companyCount = document.getElementById('companyCount');
const companyNamesContainer = document.getElementById('companyNamesContainer');

companyCount.addEventListener('input', function () {

    const existingData = [];

    document.querySelectorAll('#companyNamesContainer .company-block').forEach(block => {
        const inputs = block.querySelectorAll('input, select, textarea');

        existingData.push({
            org: inputs[0]?.value || "",
            des: inputs[1]?.value || "",
            exp: inputs[2]?.value || "",
            sal: inputs[3]?.value || "",
            join: inputs[4]?.value || "",
            rel: inputs[5]?.value || "",
            type: inputs[6]?.value || "",
            loc: inputs[7]?.value || "",
            role: inputs[8]?.value || ""
        });
    });

    companyNamesContainer.innerHTML = "";

    let count = parseInt(this.value) || 0;

    if (count > 5) {
        count = 5;
        this.value = 5;
    }

    for (let i = 0; i < count; i++) {

        const data = existingData[i] || {};

        companyNamesContainer.innerHTML += `
        <div class="form-grid company-block"
        style="margin-top:25px; padding:20px; border:1px solid #cbd5e1; border-radius:16px; background:#f8fafc;">

            <div class="form-group">
                <label>Organization Name ${i + 1}</label>
                <input type="text" value="${data.org}">
            </div>

            <div class="form-group">
                <label>Designation</label>
                <input type="text" value="${data.des}">
            </div>

            <div class="form-group">
                <label>Total Experience</label>
                <input type="text" value="${data.exp}">
            </div>

            <div class="form-group">
                <label>Current Salary</label>
                <input type="number" value="${data.sal}">
            </div>

            <div class="form-group">
                <label>Joining Date</label>
                <input type="date" value="${data.join}">
            </div>

            <div class="form-group">
                <label>Relieving Date</label>
                <input type="date" value="${data.rel}">
            </div>

            <div class="form-group">
                <label>Employment Type</label>
                <select>
    		<option ${data.type === 'Full Time' ? 'selected' : ''}>Full Time</option>
    		<option ${data.type === 'Contract' ? 'selected' : ''}>Contract</option>
    		<option ${data.type === 'Temporary' ? 'selected' : ''}>Temporary</option>
    		<option ${data.type === 'Outsourcing' ? 'selected' : ''}>Outsourcing</option>
		</select>
            </div>

            <div class="form-group">
                <label>Work Location</label>
                <input type="text" value="${data.loc}">
            </div>

            <div class="form-group full-width">
                <label>Roles & Responsibilities</label>
                <textarea>${data.role}</textarea>
            </div>

        </div>`;
    }
});

