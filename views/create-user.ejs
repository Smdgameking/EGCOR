<!DOCTYPE html>
<html lang="en">

<head>

<meta charset="UTF-8">

<meta
name="viewport"
content="width=device-width, initial-scale=1.0">

<title>
Collector Recruitment Portal
</title>


<style>

/* RESET */

*{
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}


body{

    height: 100vh;

    overflow: hidden;

    font-family: Arial, Helvetica, sans-serif;

    background: #e2e8f0;

}


/* MAIN CONTAINER */

.container{

    width: 100%;

    height: 100vh;

    display: flex;

}


/* LEFT PANEL */

.left-panel{

    width: 45%;

    background:
    linear-gradient(
        135deg,
        #0f172a,
        #1e293b
    );

    color: white;

    display: flex;

    flex-direction: column;

    justify-content: center;

    align-items: center;

    padding: 40px;

    text-align: center;

}


.logo{

    width: 100px;

    height: 100px;

    border-radius: 50%;

    background: rgba(255,255,255,0.1);

    display: flex;

    justify-content: center;

    align-items: center;

    font-size: 50px;

    margin-bottom: 20px;

}


.left-panel h1{

    font-size: 42px;

    margin-bottom: 15px;

    line-height: 1.2;

}


.left-panel p{

    font-size: 17px;

    line-height: 1.7;

    color: #cbd5e1;

    max-width: 450px;

}


.portal-tag{

    margin-top: 25px;

    padding: 12px 22px;

    border-radius: 10px;

    background: rgba(255,255,255,0.1);

    font-size: 16px;

}


/* RIGHT PANEL */

.right-panel{

    width: 55%;

    display: flex;

    justify-content: center;

    align-items: center;

    padding: 20px;

}


/* AUTH BOX */

.auth-box{

    width: 100%;

    max-width: 500px;

    background: white;

    padding: 25px;

    border-radius: 18px;

    box-shadow:
    0 10px 30px rgba(0,0,0,0.1);

}


/* TABS */

.tabs{

    display: flex;

    border: 1px solid #ddd;

    border-radius: 10px;

    overflow: hidden;

    margin-bottom: 20px;

}


.tab-btn{

    flex: 1;

    padding: 12px;

    border: none;

    background: white;

    cursor: pointer;

    font-size: 16px;

    transition: 0.3s;

}


.tab-btn.active{

    background: #111827;

    color: white;

}


/* FORMS */

form{

    display: flex;

    flex-direction: column;

    gap: 12px;

}


/* INPUT GROUP */

.input-group{

    display: flex;

    flex-direction: column;

    gap: 5px;

}


.input-group label{

    font-size: 14px;

    font-weight: bold;

    color: #222;

}


.input-group input,
.input-group select{

    padding: 10px;

    border: 1px solid #ccc;

    border-radius: 8px;

    font-size: 14px;

    outline: none;

    transition: 0.3s;

    width: 100%;

}


.input-group input:focus,
.input-group select:focus{

    border-color: #2563eb;

    box-shadow:
    0 0 5px rgba(37,99,235,0.3);

}


/* DOUBLE INPUT */

.double-input{

    display: flex;

    gap: 12px;

}


.double-input .input-group{

    flex: 1;

}


/* CAPTCHA */

.captcha-group{

    display: flex;

    justify-content: center;

    align-items: center;

    gap: 10px;

}


#captcha,
#captcha2{

    height: 55px;

    border-radius: 8px;

}


.refresh-btn{

    border: none;

    background: transparent;

    font-size: 30px;

    cursor: pointer;

    transition: 0.4s;

}


.refresh-btn:hover{

    transform: rotate(180deg);

}


/* BUTTON */

.submit-btn{

    padding: 12px;

    border: none;

    border-radius: 8px;

    background: #111827;

    color: white;

    font-size: 16px;

    cursor: pointer;

    transition: 0.3s;

    margin-top: 5px;

}


.submit-btn:hover{

    background: #1e293b;

}


/* REGISTER HIDE */

#registerForm{

    display: none;

}


/* RESPONSIVE */

@media(max-width: 950px){

    body{

        overflow: auto;

    }

    .container{

        flex-direction: column;

        height: auto;

    }

    .left-panel{

        width: 100%;

        min-height: 300px;

        padding: 30px;

    }

    .right-panel{

        width: 100%;

        padding: 20px;

    }

}


@media(max-width: 650px){

    .double-input{

        flex-direction: column;

    }

    .left-panel h1{

        font-size: 32px;

    }

    .left-panel p{

        font-size: 15px;

    }

    .auth-box{

        padding: 20px;

    }

}

</style>

</head>


<body>


<div class="container">


    <!-- LEFT PANEL -->


    <div class="left-panel">

        <div class="logo">
            🏛️
        </div>

        <h1>

            Collector Office
            Recruitment Portal

        </h1>

        <p>

            Official government recruitment portal
            for applications, hall tickets,
            examination results and recruitment management.

        </p>

        <div class="portal-tag">

            Recruitment Portal 2026

        </div>

    </div>





    <!-- RIGHT PANEL -->


    <div class="right-panel">


        <div class="auth-box">


            <!-- TABS -->


            <div class="tabs">

                <button
                    class="tab-btn active"
                    id="loginTab"
                    onclick="showLogin()"
                >
                    Login
                </button>


                <button
                    class="tab-btn"
                    id="registerTab"
                    onclick="showRegister()"
                >
                    Register
                </button>

            </div>





            <!-- LOGIN FORM -->


            <form
                id="loginForm"
                action="/login"
                method="POST"
            >

                <div class="input-group">

                    <label>Email</label>

                    <input
                        type="email"
                        name="email"
                        placeholder="Enter Email"
                        required
                    >

                </div>


                <div class="input-group">

                    <label>Password</label>

                    <input
                        type="password"
                        name="password"
                        placeholder="Enter Password"
                        required
                    >

                </div>


                <div class="captcha-group">

                    <img
                        src="/captcha"
                        id="captcha"
                    >

                    <button
                        type="button"
                        class="refresh-btn"
                        onclick="refreshCaptcha()"
                    >
                        ↻
                    </button>

                </div>


                <div class="input-group">

                    <label>Captcha</label>

                    <input
                        type="text"
                        name="captcha"
                        placeholder="Enter Captcha"
                        required
                    >

                </div>


                <button
                    type="submit"
                    class="submit-btn"
                >
                    Login
                </button>

            </form>






            <!-- REGISTER FORM -->


            <form
                id="registerForm"
                action="/register-user"
                method="POST"
            >


                <div class="double-input">

                    <div class="input-group">

                        <label>First Name</label>

                        <input
                            type="text"
                            name="firstname"
                            placeholder="First Name"
                            required
                        >

                    </div>


                    <div class="input-group">

                        <label>Last Name</label>

                        <input
                            type="text"
                            name="lastname"
                            placeholder="Last Name"
                            required
                        >

                    </div>

                </div>





                <div class="double-input">

                    <div class="input-group">

                        <label>Email</label>

                        <input
                            type="email"
                            name="email"
                            placeholder="Enter Email"
                            required
                        >

                    </div>


                    <div class="input-group">

                        <label>Phone</label>

                        <input
                            type="tel"
                            name="phone"
                            placeholder="Phone Number"
                            required
                        >

                    </div>

                </div>





                <div class="double-input">

                    <div class="input-group">

                        <label>DOB</label>

                        <input
                            type="date"
                            name="dob"
                            required
                        >

                    </div>


                    <div class="input-group">

                        <label>Gender</label>

                        <select name="gender">

                            <option>
                                Male
                            </option>

                            <option>
                                Female
                            </option>

                            <option>
                                Other
                            </option>

                        </select>

                    </div>

                </div>





                <div class="double-input">

                    <div class="input-group">

                        <label>Qualification</label>

                        <select name="qualification">

                            <option>
                                10th Pass
                            </option>

                            <option>
                                12th Pass
                            </option>

                            <option>
                                Diploma
                            </option>

                            <option>
                                Degree
                            </option>

                            <option>
                                B.Tech
                            </option>

                        </select>

                    </div>


                    <div class="input-group">

                        <label>Password</label>

                        <input
                            type="password"
                            name="password"
                            placeholder="Password"
                            required
                        >

                    </div>

                </div>





                <div class="double-input">

                    <div class="input-group">

                        <label>Confirm Password</label>

                        <input
                            type="password"
                            name="confirmpassword"
                            placeholder="Confirm Password"
                            required
                        >

                    </div>


                    <div class="input-group">

                        <label>Captcha</label>

                        <input
                            type="text"
                            name="captcha"
                            placeholder="Enter Captcha"
                            required
                        >

                    </div>

                </div>





                <div class="captcha-group">

                    <img
                        src="/captcha"
                        id="captcha2"
                    >

                    <button
                        type="button"
                        class="refresh-btn"
                        onclick="refreshCaptcha2()"
                    >
                        ↻
                    </button>

                </div>





                <button
                    type="submit"
                    class="submit-btn"
                >
                    Register
                </button>


            </form>


        </div>


    </div>


</div>




<script>

function showRegister(){

    document.getElementById(
        "loginForm"
    ).style.display = "none";


    document.getElementById(
        "registerForm"
    ).style.display = "flex";


    document.getElementById(
        "registerTab"
    ).classList.add("active");


    document.getElementById(
        "loginTab"
    ).classList.remove("active");

}



function showLogin(){

    document.getElementById(
        "registerForm"
    ).style.display = "none";


    document.getElementById(
        "loginForm"
    ).style.display = "flex";


    document.getElementById(
        "loginTab"
    ).classList.add("active");


    document.getElementById(
        "registerTab"
    ).classList.remove("active");

}



function refreshCaptcha(){

    document.getElementById(
        "captcha"
    ).src =
    "/captcha?" + Date.now();

}



function refreshCaptcha2(){

    document.getElementById(
        "captcha2"
    ).src =
    "/captcha?" + Date.now();

}

</script>


</body>

</html>