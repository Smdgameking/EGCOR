<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    <style>
        body {
            margin: 0;
            font-family: 'Poppins', sans-serif;
            background: #f8fafc;
            color: #0f172a;
            display: flex;
            justify-content: center;
            align-items: center;
            min-height: 100vh;
            padding: 20px;
        }
        .error-card {
            max-width: 760px;
            width: 100%;
            background: #ffffff;
            border-radius: 24px;
            box-shadow: 0 24px 60px rgba(15, 23, 42, 0.12);
            padding: 40px;
            border: 1px solid #e2e8f0;
        }
        .error-card h1 {
            margin-bottom: 14px;
            font-size: 32px;
            color: #1e293b;
        }
        .error-card p {
            margin-bottom: 18px;
            line-height: 1.7;
            color: #475569;
        }
        .error-card pre {
            background: #f1f5f9;
            color: #0f172a;
            border-radius: 12px;
            border: 1px solid #cbd5e1;
            padding: 18px;
            overflow-x: auto;
            white-space: pre-wrap;
            word-break: break-word;
        }
        .button-row {
            display: flex;
            gap: 12px;
            flex-wrap: wrap;
        }
        .button-row a {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            padding: 14px 22px;
            border-radius: 999px;
            text-decoration: none;
            color: #ffffff;
            background: #2563eb;
            transition: background 0.2s ease;
        }
        .button-row a:hover {
            background: #1d4ed8;
        }
        .details-note {
            margin-top: 20px;
            font-size: 14px;
            color: #64748b;
        }
    </style>
</head>
<body>
    <div class="error-card">
        <h1><%= title %></h1>
        <p><%= message %></p>
        <% if (details) { %>
            <pre><%= details %></pre>
        <% } %>
        <div class="button-row">
            <a href="<%= backUrl || '/' %>">Go back</a>
            <a href="/dashboard">Dashboard</a>
        </div>
        <p class="details-note">If this problem persists, please contact your administrator with the error details shown above.</p>
    </div>
</body>
</html>