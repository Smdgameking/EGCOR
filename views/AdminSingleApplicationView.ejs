<!-- views/AdminSingleApplicationView.ejs -->

<!DOCTYPE html>
<html lang="en">
<head>

<meta charset="UTF-8">

<meta
name="viewport"
content="width=device-width, initial-scale=1.0">

<title>
Application Details
</title>

<style>

*{
    margin:0;
    padding:0;
    box-sizing:border-box;
    font-family:Arial,sans-serif;
}

body{
    background:#f1f5f9;
    padding:30px;
    color:#111827;
}

.container{
    max-width:1400px;
    margin:auto;
}

/* HEADER */

.topbar{
    display:flex;
    justify-content:space-between;
    align-items:center;
    flex-wrap:wrap;
    gap:20px;
    margin-bottom:30px;
}

.topbar h1{
    font-size:34px;
}

.topbar p{
    color:#64748b;
    margin-top:8px;
}

/* SECTION */

.section{

    background:white;

    border-radius:24px;

    padding:25px;

    margin-bottom:25px;

    box-shadow:
    0 4px 15px rgba(0,0,0,0.06);

}

.section h2{
    margin-bottom:20px;
}

/* GRID */

.grid{
    display:grid;

    grid-template-columns:
    repeat(auto-fit,minmax(280px,1fr));

    gap:20px;
}

.form-group{
    display:flex;
    flex-direction:column;
}

.full-width{
    grid-column:1/-1;
}

.form-group label{
    margin-bottom:8px;
    font-weight:bold;
}

.data-box{

    padding:14px;

    border-radius:12px;

    border:1px solid #d1d5db;

    background:#f8fafc;

    min-height:50px;
}

/* CARD */

.card{

    background:#f8fafc;

    border:1px solid #e5e7eb;

    border-radius:18px;

    padding:20px;

    margin-bottom:20px;
}

.card h3{
    margin-bottom:18px;
}

/* DOCUMENTS */

.document-box{

    display:flex;

    justify-content:space-between;

    align-items:center;

    gap:15px;

    flex-wrap:wrap;

    background:#f8fafc;

    border:1px solid #e5e7eb;

    border-radius:14px;

    padding:16px;

    margin-bottom:15px;
}

.document-actions{
    display:flex;
    gap:10px;
}

.preview-btn,
.download-btn{

    text-decoration:none;

    color:white;

    padding:10px 14px;

    border-radius:10px;

    font-size:14px;

    font-weight:bold;
}

.preview-btn{
    background:#2563eb;
}

.download-btn{
    background:#059669;
}

/* BUTTONS */

.button-group{
    display:flex;
    justify-content:center;
    gap:15px;
    flex-wrap:wrap;
    margin-top:30px;
}

.accept-btn,
.reject-btn,
.back-btn{

    border:none;

    color:white;

    padding:14px 20px;

    border-radius:12px;

    cursor:pointer;

    font-weight:bold;

    text-decoration:none;
}

.accept-btn{
    background:#059669;
}

.reject-btn{
    background:#dc2626;
}

.back-btn{
    background:#111827;
}

</style>
</head>
<body>

<div class="container">

<!-- HEADER -->

<div class="topbar">

<div>

<h1>
Application Details 📄
</h1>

<p>
Review complete candidate information
</p>

</div>

</div>

<!-- GENERAL DETAILS -->

<div class="section">

<h2>
General Details
</h2>

<div class="grid">

<div class="form-group">

<label>
Full Name
</label>

<div class="data-box">

<%= application.fullname %>

</div>

</div>


<div class="form-group">

<label>
Email
</label>

<div class="data-box">

<%= application.email %>

</div>

</div>


<div class="form-group">

<label>
Mobile Number
</label>

<div class="data-box">

<%= application.mobileno %>

</div>

</div>


<div class="form-group">

<label>
Gender
</label>

<div class="data-box">

<%= application.gender %>

</div>

</div>


<div class="form-group">

<label>
Category
</label>

<div class="data-box">

<%= application.category %>

</div>

</div>


<div class="form-group">

<label>
Annual Income
</label>

<div class="data-box">

<%= application.annualincome %>

</div>

</div>


<div class="form-group">

<label>
Father Name
</label>

<div class="data-box">

<%= application.fathername %>

</div>

</div>


<div class="form-group">

<label>
Mother Name
</label>

<div class="data-box">

<%= application.mothername %>

</div>

</div>


<div class="form-group full-width">

<label>
Address
</label>

<div class="data-box">

<%= application.fulladdress %>

</div>

</div>

</div>

</div>


<!-- EDUCATION -->

<div class="section">

<h2>
Education
</h2>

<div class="grid">

<div class="form-group">

<label>
SSC Board
</label>

<div class="data-box">

<%= application.education.ssc.board %>

</div>

</div>


<div class="form-group">

<label>
SSC Percentage
</label>

<div class="data-box">

<%= application.education.ssc.percentage %>

</div>

</div>


<div class="form-group">

<label>
Intermediate / Diploma
</label>

<div class="data-box">

<%= application.education.intermediateOrDiploma %>

</div>

</div>


<div class="form-group">

<label>
Higher Studies
</label>

<div class="data-box">

<%= application.education.higherStudies.stype %>

</div>

</div>

</div>

</div>


<!-- COMPANIES -->

<div class="section">

<h2>
Company Experience
</h2>

<% companies.forEach(company => { %>

<div class="card">

<h3>

<%= company.organization %>

</h3>

<div class="grid">

<div class="form-group">

<label>
Designation
</label>

<div class="data-box">

<%= company.designation %>

</div>

</div>


<div class="form-group">

<label>
Experience
</label>

<div class="data-box">

<%= company.totalExperience %>

</div>

</div>


<div class="form-group">

<label>
Employment Type
</label>

<div class="data-box">

<%= company.employmentType %>

</div>

</div>


<div class="form-group">

<label>
Location
</label>

<div class="data-box">

<%= company.location %>

</div>

</div>


<div class="form-group full-width">

<label>
Roles & Responsibilities
</label>

<div class="data-box">

<%= company.rolesResponsibilities %>

</div>

</div>

</div>

</div>

<% }) %>

</div>


<!-- INTERNSHIPS -->

<div class="section">

<h2>
Internships
</h2>

<% internships.forEach(internship => { %>

<div class="card">

<h3>

<%= internship.organization %>

</h3>

<div class="grid">

<div class="form-group">

<label>
Role
</label>

<div class="data-box">

<%= internship.role %>

</div>

</div>


<div class="form-group">

<label>
Duration
</label>

<div class="data-box">

<%= internship.duration %>

</div>

</div>


<div class="form-group">

<label>
Stipend
</label>

<div class="data-box">

<%= internship.stipend %>

</div>

</div>


<div class="form-group full-width">

<label>
Skills Learned
</label>

<div class="data-box">

<%= internship.skillsLearned %>

</div>

</div>

</div>

</div>

<% }) %>

</div>


<!-- DOCUMENTS -->

<div class="section">

<h2>
Documents
</h2>

<% Object.entries(application.documents).forEach(doc => { %>

<% if(doc[1]){ %>

<div class="document-box">

<div>

<strong>

<%= doc[0] %>

</strong>

</div>

<div class="document-actions">

<!-- PREVIEW -->

<a
href="/admin/preview/<%= doc[1].replace('uploads/','') %>"
target="_blank"
class="preview-btn">

Preview

</a>



<!-- DOWNLOAD -->

<a
href="/admin/download/<%= doc[1].replace('uploads/','') %>"
class="download-btn">

Download

</a>

</div>

</div>

<% } %>

<% }) %>

</div>


<!-- BUTTONS -->

<div class="button-group">

<form
action="/admin/application/accept/<%= application._id %>"
method="POST">

<button class="accept-btn">

Accept Application

</button>

</form>


<form
action="/admin/application/reject/<%= application._id %>"
method="POST">

<button class="reject-btn">

Reject Application

</button>

</form>


<a
href="/admin/applications"
class="back-btn">

Back

</a>

</div>

</div>

</body>
</html>