
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Admin Applications</title>

<style>

*{
    margin:0;
    padding:0;
    box-sizing:border-box;
    font-family:Arial,sans-serif;
}

body{
    background:#f1f5f9;
    color:#111827;
}

.container{
    display:flex;
    min-height:100vh;
}

/* SIDEBAR */

.sidebar{
    width:280px;
    background:linear-gradient(180deg,#1e3a8a,#2563eb);
    color:white;
    padding:25px;
    position:sticky;
    top:0;
    height:100vh;
}

.logo{
    display:flex;
    align-items:center;
    gap:12px;
    margin-bottom:40px;
}

.logo-icon{
    width:50px;
    height:50px;
    border-radius:14px;
    background:rgba(255,255,255,0.15);
    display:flex;
    justify-content:center;
    align-items:center;
    font-size:24px;
}

.sidebar-links{
    display:flex;
    flex-direction:column;
    gap:14px;
}

.sidebar-links a{
    text-decoration:none;
    color:white;
    padding:14px 16px;
    border-radius:12px;
    transition:0.3s;
    font-weight:bold;
}

.sidebar-links a:hover,
.active-link{
    background:rgba(255,255,255,0.18);
}

/* MAIN */

.main{
    flex:1;
    padding:30px;
}

.topbar{
    display:flex;
    justify-content:space-between;
    align-items:center;
    margin-bottom:30px;
    flex-wrap:wrap;
    gap:20px;
}

.topbar h1{
    font-size:34px;
}

.topbar p{
    color:#64748b;
    margin-top:8px;
}

/* TABLE */

.table-box{
    background:white;
    border-radius:24px;
    padding:25px;
    box-shadow:0 4px 15px rgba(0,0,0,0.06);
}

.table{
    width:100%;
    border-collapse:collapse;
}

.table th,
.table td{
    padding:16px;
    border-bottom:1px solid #e5e7eb;
    text-align:left;
}

.table th{
    background:#f8fafc;
}

.status{
    padding:8px 14px;
    border-radius:20px;
    font-size:13px;
    font-weight:bold;
}

.pending{
    background:#fef3c7;
    color:#92400e;
}

.accepted{
    background:#dcfce7;
    color:#166534;
}

.rejected{
    background:#fee2e2;
    color:#991b1b;
}

.review{
    background:#dbeafe;
    color:#1d4ed8;
}

.view-btn{
    border:none;
    background:#2563eb;
    color:white;
    padding:10px 16px;
    border-radius:10px;
    cursor:pointer;
    text-decoration:none;
    font-weight:bold;
}

/* MODAL */

.modal{
    position:fixed;
    inset:0;
    background:rgba(0,0,0,0.5);
    display:flex;
    justify-content:center;
    align-items:center;
    z-index:999;
    padding:20px;
}

.modal-content{
    width:100%;
    max-width:1400px;
    max-height:95vh;
    overflow-y:auto;
    background:white;
    border-radius:24px;
    padding:30px;
}

.tab-buttons{
    display:flex;
    gap:10px;
    flex-wrap:wrap;
    margin-bottom:30px;
}

.tab-btn{
    border:none;
    padding:12px 18px;
    border-radius:12px;
    background:#e5e7eb;
    cursor:pointer;
    font-weight:bold;
}

.active-tab{
    background:#2563eb;
    color:white;
}

.tab-content{
    display:none;
}

.active-content{
    display:block;
}

.form-grid{
    display:grid;
    grid-template-columns:repeat(auto-fit,minmax(280px,1fr));
    gap:20px;
}

.form-group{
    display:flex;
    flex-direction:column;
}

.full-width{
    grid-column:1/-1;
}

.form-group label{
    margin-bottom:8px;
    font-weight:bold;
}

.data-box{
    padding:14px;
    border-radius:12px;
    border:1px solid #d1d5db;
    background:#f8fafc;
    min-height:50px;
}

.card{
    background:#f8fafc;
    border:1px solid #e5e7eb;
    border-radius:18px;
    padding:20px;
    margin-bottom:20px;
}

.card h3{
    margin-bottom:20px;
}

.document-box{
    display:flex;
    justify-content:space-between;
    align-items:center;
    gap:15px;
    flex-wrap:wrap;
    background:#f8fafc;
    border:1px solid #e5e7eb;
    border-radius:14px;
    padding:16px;
    margin-bottom:15px;
}

.document-actions{
    display:flex;
    gap:10px;
}

.preview-btn,
.download-btn{
    text-decoration:none;
    color:white;
    padding:10px 14px;
    border-radius:10px;
    font-size:14px;
    font-weight:bold;
}

.preview-btn{
    background:#2563eb;
}

.download-btn{
    background:#059669;
}

.bottom-buttons{
    display:flex;
    justify-content:center;
    gap:15px;
    flex-wrap:wrap;
    margin-top:30px;
}

.accept-btn,
.reject-btn,
.close-btn{
    border:none;
    color:white;
    padding:14px 20px;
    border-radius:12px;
    cursor:pointer;
    font-weight:bold;
}

.accept-btn{
    background:#059669;
}

.reject-btn{
    background:#dc2626;
}

.close-btn{
    background:#111827;
}

@media(max-width:1000px){

    .container{
        flex-direction:column;
    }

    .sidebar{
        width:100%;
        height:auto;
        position:relative;
    }

}

</style>
</head>
<body>

<div class="container">

<!-- SIDEBAR -->

<div class="sidebar">

<div class="logo">

<div class="logo-icon">
🏛️
</div>

<h2>
Admin Panel
</h2>

</div>

<div class="sidebar-links">

<a href="/admin/dashboard">
📊 Dashboard
</a>

<a href="/admin/jobs">
💼 Jobs
</a>

<a href="/admin/applications" class="active-link">
📄 Applications
</a>

<a href="/logout">
🚪 Logout
</a>

</div>

</div>

<!-- MAIN -->

<div class="main">

<div class="topbar">

<div>
<h1>
Manage Applications 📄
</h1>

<p>
Review, verify and manage candidate applications.
</p>
</div>

</div>

<div class="table-box">

<table class="table">

<thead>
<tr>
<th>Candidate</th>
<th>Email</th>
<th>Status</th>
<th>Action</th>
</tr>
</thead>

<tbody>

<% applications.forEach(application => { %>

<tr>

<td>
<%= application.fullname %>
</td>

<td>
<%= application.email %>
</td>


<td>

<span class="status <%= application.status === 'pending' ? 'pending' : application.status === 'accepted' ? 'accepted' : application.status === 'rejected' ? 'rejected' : 'review' %>">

<%= application.status %>

</span>

</td>

<td>

<a href="/admin/application/<%= application._id %>" class="view-btn">
View
</a>

</td>

</tr>

<% }) %>

</tbody>

</table>

</div>

</div>

</div>


<% if(singleApplication){ %>

<div class="modal">

<div class="modal-content">

<div class="tab-buttons">

<button class="tab-btn active-tab" onclick="openTab(event,'general')">
General
</button>

<button class="tab-btn" onclick="openTab(event,'education')">
Education
</button>

<button class="tab-btn" onclick="openTab(event,'experience')">
Experience
</button>

<button class="tab-btn" onclick="openTab(event,'documents')">
Documents
</button>

</div>

<!-- GENERAL -->

<div class="tab-content active-content" id="general">

<div class="form-grid">

<div class="form-group">
<label>Full Name</label>
<div class="data-box">
<%= singleApplication.fullname %>
</div>
</div>

<div class="form-group">
<label>Email</label>
<div class="data-box">
<%= singleApplication.email %>
</div>
</div>

<div class="form-group">
<label>Mobile</label>
<div class="data-box">
<%= singleApplication.mobileno %>
</div>
</div>

<div class="form-group">
<label>Gender</label>
<div class="data-box">
<%= singleApplication.gender %>
</div>
</div>

<div class="form-group">
<label>Category</label>
<div class="data-box">
<%= singleApplication.category %>
</div>
</div>

<div class="form-group">
<label>Income</label>
<div class="data-box">
<%= singleApplication.annualincome %>
</div>
</div>

<div class="form-group full-width">
<label>Address</label>
<div class="data-box">
<%= singleApplication.fulladdress %>
</div>
</div>

</div>

</div>

<!-- EDUCATION -->

<div class="tab-content" id="education">

<div class="form-grid">

<div class="form-group">
<label>SSC Board</label>
<div class="data-box">
<%= singleApplication.education.ssc.board %>
</div>
</div>

<div class="form-group">
<label>SSC Percentage</label>
<div class="data-box">
<%= singleApplication.education.ssc.percentage %>
</div>
</div>

<div class="form-group">
<label>Intermediate / Diploma</label>
<div class="data-box">
<%= singleApplication.education.intermediateOrDiploma %>
</div>
</div>

<div class="form-group">
<label>Higher Studies</label>
<div class="data-box">
<%= singleApplication.education.higherStudies.stype %>
</div>
</div>

</div>

</div>

<!-- EXPERIENCE -->

<div class="tab-content" id="experience">

<h2 style="margin-bottom:20px;">
Companies
</h2>

<% companies.forEach(company => { %>

<div class="card">

<h3>
<%= company.organization %>
</h3>

<div class="form-grid">

<div class="form-group">
<label>Designation</label>
<div class="data-box">
<%= company.designation %>
</div>
</div>

<div class="form-group">
<label>Total Experience</label>
<div class="data-box">
<%= company.totalExperience %>
</div>
</div>

<div class="form-group">
<label>Employment Type</label>
<div class="data-box">
<%= company.employmentType %>
</div>
</div>

<div class="form-group">
<label>Location</label>
<div class="data-box">
<%= company.location %>
</div>
</div>

<div class="form-group full-width">
<label>Roles & Responsibilities</label>
<div class="data-box">
<%= company.rolesResponsibilities %>
</div>
</div>

</div>

</div>

<% }) %>


<h2 style="margin:30px 0 20px 0;">
Internships
</h2>

<% internships.forEach(internship => { %>

<div class="card">

<h3>
<%= internship.organization %>
</h3>

<div class="form-grid">

<div class="form-group">
<label>Role</label>
<div class="data-box">
<%= internship.role %>
</div>
</div>

<div class="form-group">
<label>Duration</label>
<div class="data-box">
<%= internship.duration %>
</div>
</div>

<div class="form-group">
<label>Stipend</label>
<div class="data-box">
<%= internship.stipend %>
</div>
</div>

<div class="form-group full-width">
<label>Skills Learned</label>
<div class="data-box">
<%= internship.skillsLearned %>
</div>
</div>

</div>

</div>

<% }) %>

</div>

<!-- DOCUMENTS -->

<div class="tab-content" id="documents">

<% Object.entries(singleApplication.documents).forEach(doc => { %>

<% if(doc[1]){ %>

<div class="document-box">

<div>
<strong>
<%= doc[0] %>
</strong>
</div>

<div class="document-actions">

<!-- PREVIEW -->

<a
href="/admin/preview/<%= doc[1].replace('uploads/','') %>"
target="_blank"
class="preview-btn">

Preview

</a>



<!-- DOWNLOAD -->

<a
href="/admin/download/<%= doc[1].replace('uploads/','') %>"
class="download-btn">

Download

</a>

</div>

</div>

<% } %>

<% }) %>

</div>


<div class="bottom-buttons">

<form action="/admin/application/accept/<%= singleApplication._id %>" method="POST">
<button class="accept-btn">
Accept
</button>
</form>

<form action="/admin/application/reject/<%= singleApplication._id %>" method="POST">
<button class="reject-btn">
Reject
</button>
</form>

<button class="close-btn" onclick="window.location.href='/admin/applications'">
Close
</button>

</div>

</div>

</div>

<% } %>

<script>

function openTab(event,tabId){

   document
   .querySelectorAll('.tab-content')
   .forEach(content => {

      content.classList.remove('active-content');

   });


   document
   .querySelectorAll('.tab-btn')
   .forEach(button => {

      button.classList.remove('active-tab');

   });


   document
   .getElementById(tabId)
   .classList
   .add('active-content');


   event.target.classList.add('active-tab');

}

</script>

</body>
</html>
