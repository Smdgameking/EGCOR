<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta
name="viewport"
content="width=device-width, initial-scale=1.0">

<title>
Manage News
</title>

<style>

*{
    margin:0;
    padding:0;
    box-sizing:border-box;
    font-family:Arial,sans-serif;
}

body{
    background:#f1f5f9;
    color:#111827;
}

.container{
    display:flex;
    min-height:100vh;
}

/* SIDEBAR */

.sidebar{
    width:280px;

    background:
    linear-gradient(
        180deg,
        #1e3a8a,
        #2563eb
    );

    color:white;

    padding:25px;

    position:sticky;
    top:0;

    height:100vh;
}

.logo{
    display:flex;
    align-items:center;
    gap:12px;
    margin-bottom:40px;
}

.logo-icon{
    width:50px;
    height:50px;

    border-radius:14px;

    background:
    rgba(255,255,255,0.15);

    display:flex;
    justify-content:center;
    align-items:center;

    font-size:24px;
}

.logo h2{
    font-size:22px;
}

.sidebar-links{
    display:flex;
    flex-direction:column;
    gap:14px;
}

.sidebar-links a{
    text-decoration:none;
    color:white;

    padding:14px 16px;

    border-radius:12px;

    transition:0.3s;

    font-weight:bold;
}

.sidebar-links a:hover,
.active-link{
    background:
    rgba(255,255,255,0.18);
}

/* MAIN */

.main{
    flex:1;
    padding:30px;
}

/* HEADER */

.topbar{
    display:flex;
    justify-content:space-between;
    align-items:center;
    flex-wrap:wrap;
    gap:20px;

    margin-bottom:30px;
}

.topbar h1{
    font-size:34px;
    margin-bottom:8px;
}

.topbar p{
    color:#64748b;
}

/* FORM */

.news-form-box{
    background:white;

    border-radius:24px;

    padding:30px;

    box-shadow:
    0 4px 15px rgba(0,0,0,0.06);

    margin-bottom:40px;
}

.section-title{
    font-size:28px;
    margin-bottom:20px;
}

.news-form{
    display:grid;

    grid-template-columns:
    repeat(auto-fit,minmax(300px,1fr));

    gap:20px;
}

.form-group{
    display:flex;
    flex-direction:column;
}

.full-width{
    grid-column:1/-1;
}

.form-group label{
    margin-bottom:8px;
    font-weight:bold;
}

.form-group input,
.form-group textarea,
.form-group select{

    padding:14px;

    border-radius:12px;

    border:1px solid #d1d5db;

    background:#f8fafc;

    outline:none;
}

.form-group textarea{
    resize:none;
    height:140px;
}

.submit-btn{

    border:none;

    background:
    linear-gradient(
        135deg,
        #2563eb,
        #1d4ed8
    );

    color:white;

    padding:15px;

    border-radius:14px;

    cursor:pointer;

    font-size:16px;

    font-weight:bold;
}

/* NEWS CARDS */

.news-grid{
    display:grid;

    grid-template-columns:
    repeat(auto-fit,minmax(320px,1fr));

    gap:20px;
}

.news-card{

    background:white;

    border-radius:22px;

    padding:25px;

    box-shadow:
    0 4px 15px rgba(0,0,0,0.06);

    transition:0.3s;
}

.news-card:hover{
    transform:translateY(-5px);
}

.news-top{
    display:flex;
    justify-content:space-between;
    align-items:center;

    gap:10px;

    margin-bottom:15px;
}

.news-badge{

    background:#dbeafe;

    color:#1d4ed8;

    padding:8px 14px;

    border-radius:20px;

    font-size:13px;

    font-weight:bold;
}

.news-card p{
    color:#64748b;
    line-height:1.7;
    margin-bottom:18px;
}

.news-footer{
    display:flex;
    justify-content:space-between;
    align-items:center;
    flex-wrap:wrap;
    gap:12px;
}

.news-date{
    color:#64748b;
    font-size:14px;
}

.action-buttons{
    display:flex;
    gap:10px;
}

.edit-btn,
.delete-btn{

    border:none;

    padding:10px 14px;

    border-radius:10px;

    cursor:pointer;

    font-weight:bold;
}

.edit-btn{
    background:#dbeafe;
    color:#1d4ed8;
}

.delete-btn{
    background:#fee2e2;
    color:#dc2626;
}

/* RESPONSIVE */

@media(max-width:1000px){

    .container{
        flex-direction:column;
    }

    .sidebar{
        width:100%;
        height:auto;
        position:relative;
    }

}

@media(max-width:700px){

    .main{
        padding:18px;
    }

    .topbar h1{
        font-size:28px;
    }

}

</style>
</head>
<body>

<div class="container">


<!-- SIDEBAR -->

<div class="sidebar">

    <div class="logo">

        <div class="logo-icon">
            🏛️
        </div>

        <h2>
            Admin Panel
        </h2>

    </div>


    <div class="sidebar-links">

        <a href="/admin/dashboard">
            📊 Dashboard
        </a>

        <a href="/admin/jobs">
            💼 Jobs
        </a>

        <a
        href="/admin/news"
        class="active-link">

            📰 News

        </a>

        <a href="/admin/notifications">
            🔔 Notifications
        </a>

        <a href="/admin/applications">
            📄 Applications
        </a>

        <a href="/logout">
            🚪 Logout
        </a>

    </div>

</div>



<!-- MAIN -->

<div class="main">


<!-- TOPBAR -->

<div class="topbar">

    <div>

        <h1>
            Manage News 📰
        </h1>

        <p>
            Publish latest updates and announcements.
        </p>

    </div>

</div>



<!-- ADD NEWS -->

<div class="news-form-box">

    <h2 class="section-title">

        Add News

    </h2>


    <form
    action="/admin/add-news"
    method="POST"
    class="news-form">


        <div class="form-group">

            <label>
                News Title
            </label>

            <input
            type="text"
            name="title"
            placeholder="Enter News Title"
            required>

        </div>



        <div class="form-group">

            <label>
                Category
            </label>

            <select
            name="category"
            required>

                <option value="">
                    Select Category
                </option>

                <option value="Jobs">
                    Jobs
                </option>

                <option value="Results">
                    Results
                </option>

                <option value="Exam">
                    Exam
                </option>

                <option value="Hall Ticket">
                    Hall Ticket
                </option>

                <option value="General">
                    General
                </option>

            </select>

        </div>



        <div class="form-group full-width">

            <label>
                News Description
            </label>

            <textarea
            name="description"
            placeholder="Enter full news description..."
            required></textarea>

        </div>



        <div class="form-group full-width">

            <button class="submit-btn">

                Publish News

            </button>

        </div>


    </form>

</div>



<!-- NEWS LIST -->

<h2 class="section-title">

    Published News

</h2>


<div class="news-grid">


    <% news.forEach(singleNews => { %>

    <div class="news-card">


        <div class="news-top">

            <h3>

                <%= singleNews.title %>

            </h3>


            <div class="news-badge">

                <%= singleNews.category %>

            </div>

        </div>



        <p>

            <%= singleNews.description %>

        </p>



        <div class="news-footer">

            <span class="news-date">

                📅
                <%= singleNews.date %>

            </span>



            <div class="action-buttons">

                <button class="edit-btn">

                    Edit

                </button>


                <button class="delete-btn">

                    Delete

                </button>

            </div>

        </div>


    </div>

    <% }) %>


</div>


</div>

</div>

</body>
</html>