<!DOCTYPE html>
<html lang="en">

<head>

<meta charset="UTF-8">

<meta
name="viewport"
content="width=device-width, initial-scale=1.0">

<title>
Collector Recruitment Portal
</title>

<style>

/* RESET */

*{

    margin: 0;
    padding: 0;
    box-sizing: border-box;

}



/* BODY */

body{

    min-height: 100vh;

    font-family: Arial, Helvetica, sans-serif;

    background:
    linear-gradient(
        135deg,
        #dbeafe,
        #e2e8f0
    );

}



/* CONTAINER */

.container{

    width: 100%;

    min-height: 100vh;

    display: flex;

}



/* LEFT PANEL */

.left-panel{

    width: 45%;

    background:
    linear-gradient(
        135deg,
        #0f172a,
        #1e293b
    );

    color: white;

    display: flex;

    flex-direction: column;

    justify-content: center;

    align-items: center;

    text-align: center;

    padding: 40px;

}


.logo{

    width: 110px;
    height: 110px;

    border-radius: 50%;

    background:
    rgba(255,255,255,0.1);

    display: flex;

    justify-content: center;
    align-items: center;

    font-size: 50px;

    margin-bottom: 25px;

    backdrop-filter: blur(10px);

}


.left-panel h1{

    font-size: 46px;

    margin-bottom: 20px;

    line-height: 1.2;

}


.left-panel p{

    color: #cbd5e1;

    line-height: 1.8;

    max-width: 500px;

    font-size: 17px;

}


.portal-tag{

    margin-top: 30px;

    padding: 12px 22px;

    border-radius: 12px;

    background:
    rgba(255,255,255,0.1);

}



/* RIGHT PANEL */

.right-panel{

    width: 55%;

    display: flex;

    justify-content: center;
    align-items: center;

    padding: 20px;

}



/* AUTH BOX */

.auth-box{

    width: 100%;

    max-width: 560px;

    background: white;

    padding: 30px;

    border-radius: 22px;

    box-shadow:
    0 10px 40px rgba(0,0,0,0.12);

}



/* TABS */

.tabs{

    display: flex;

    border: 1px solid #ddd;

    border-radius: 12px;

    overflow: hidden;

    margin-bottom: 20px;

}


.tab-btn{

    flex: 1;

    padding: 14px;

    border: none;

    background: white;

    cursor: pointer;

    font-size: 16px;

    transition: 0.3s;

}


.tab-btn.active{

    background: #111827;

    color: white;

}



/* ERROR BOX */

#errorBox{

    display: none;

    background: #fee2e2;

    color: #dc2626;

    padding: 12px;

    border-radius: 10px;

    margin-bottom: 18px;

    font-size: 14px;

    font-weight: bold;

}



/* FORM */

form{

    display: flex;

    flex-direction: column;

    gap: 14px;

}


#registerForm{

    display: none;

}



/* DOUBLE INPUT */

.double-input{

    display: flex;

    gap: 12px;

}


.double-input .input-group{

    flex: 1;

}



/* INPUT GROUP */

.input-group{

    display: flex;

    flex-direction: column;

    gap: 5px;

}


.input-group label{

    font-size: 14px;

    font-weight: bold;

    color: #111827;

}



/* INPUT */

.input-group input,
.input-group select{

    width: 100%;

    padding: 12px;

    border: 1px solid #ccc;

    border-radius: 10px;

    outline: none;

    font-size: 14px;

    transition: 0.3s;

}


.input-group input:focus,
.input-group select:focus{

    border-color: #2563eb;

    box-shadow:
    0 0 10px rgba(37,99,235,0.2);

}


.input-group input:hover,
.input-group select:hover{

    border-color: #2563eb;

}



/* VALIDATION */

.valid-input{

    border-color: #22c55e !important;

    box-shadow:
    0 0 8px rgba(34,197,94,0.3);

}


.invalid-input{

    border-color: #ef4444 !important;

    box-shadow:
    0 0 8px rgba(239,68,68,0.3);

}



/* PASSWORD */

.password-wrapper{

    position: relative;

}


.password-toggle{

    position: absolute;

    top: 50%;
    right: 12px;

    transform: translateY(-50%);

    cursor: pointer;

    user-select: none;

}



/* PASSWORD STRENGTH */

.password-strength{

    margin-top: 5px;

}


.strength-bar{

    width: 100%;

    height: 8px;

    background: #ddd;

    border-radius: 20px;

    overflow: hidden;

}


#strengthFill{

    width: 0%;

    height: 100%;

    transition: 0.4s;

}


#strengthText{

    display: block;

    margin-top: 5px;

    font-size: 12px;

}



/* ERROR MESSAGE */

.error-message{

    color: #dc2626;

    font-size: 12px;

}



/* CAPTCHA */

.captcha-group{

    display: flex;

    justify-content: center;
    align-items: center;

    gap: 10px;

}


#captcha,
#captcha2{

    height: 55px;

    border-radius: 10px;

}


.refresh-btn{

    border: none;

    background: transparent;

    font-size: 30px;

    cursor: pointer;

    transition: 0.4s;

}


.refresh-btn:hover{

    transform: rotate(180deg);

}



/* BUTTON */

.submit-btn{

    padding: 13px;

    border: none;

    border-radius: 10px;

    background: #111827;

    color: white;

    font-size: 16px;

    cursor: pointer;

    transition: 0.3s;

}


.submit-btn:hover{

    background: #1e293b;

    transform: translateY(-2px);

}


.submit-btn.loading{

    opacity: 0.7;

    pointer-events: none;

}



/* RESPONSIVE */

@media(max-width: 950px){

    .container{

        flex-direction: column;

    }

    .left-panel{

        width: 100%;

        min-height: 320px;

    }

    .right-panel{

        width: 100%;

    }

}


@media(max-width: 650px){

    .double-input{

        flex-direction: column;

    }

    .left-panel h1{

        font-size: 34px;

    }

}

</style>

</head>


<body>


<div class="container">



    <!-- LEFT PANEL -->



    <div class="left-panel">

        <div class="logo">
            🏛️
        </div>

        <h1>

            Collector Office
            Recruitment Portal

        </h1>

        <p>

            Official government recruitment portal
            for applications, hall tickets,
            results and recruitment management.

        </p>

        <div class="portal-tag">

            Recruitment Portal 2026

        </div>

    </div>





    <!-- RIGHT PANEL -->



    <div class="right-panel">


        <div class="auth-box">


            <!-- TABS -->


            <div class="tabs">

                <button
                    class="tab-btn active"
                    id="loginTab"
                    onclick="showLogin()"
                >
                    Login
                </button>


                <button
                    class="tab-btn"
                    id="registerTab"
                    onclick="showRegister()"
                >
                    Register
                </button>

            </div>



            <!-- ERROR BOX -->


            <div id="errorBox"></div>





            <!-- LOGIN FORM -->


            <form
                id="loginForm"
                action="/login"
                method="POST"
            >

                <div class="input-group">

                    <label>Email</label>

                    <input
                        type="email"
                        name="email"
                        placeholder="Enter Email"
                        required
                    >

                </div>


                <div class="input-group">

                    <label>Password</label>

                    <div class="password-wrapper">

                        <input
                            type="password"
                            id="loginPassword"
                            name="password"
                            placeholder="Enter Password"
                            required
                        >

                        <span
                            class="password-toggle"
                            onclick="togglePassword('loginPassword')"
                        >
                            👁️
                        </span>

                    </div>

                </div>


                <div class="captcha-group">

                    <img
                        src="/captcha"
                        id="captcha"
                    >

                    <button
                        type="button"
                        class="refresh-btn"
                        onclick="refreshCaptcha()"
                    >
                        ↻
                    </button>

                </div>


                <div class="input-group">

                    <label>Captcha</label>

                    <input
                        type="text"
                        name="captcha"
                        placeholder="Enter Captcha"
                        required
                    >

                </div>


                <button
                    type="submit"
                    class="submit-btn"
                >
                    Login
                </button>

            </form>






            <!-- REGISTER FORM -->


            <form
                id="registerForm"
                action="/register-user"
                method="POST"
            >


                <div class="double-input">

                    <div class="input-group">

                        <label>First Name</label>

                        <input
                            type="text"
                            name="firstname"
                            placeholder="First Name"
                            required
                        >

                    </div>


                    <div class="input-group">

                        <label>Last Name</label>

                        <input
                            type="text"
                            name="lastname"
                            placeholder="Last Name"
                            required
                        >

                    </div>

                </div>





                <div class="double-input">

                    <div class="input-group">

                        <label>Email</label>

                        <input
                            type="email"
                            id="emailInput"
                            name="email"
                            placeholder="Enter Email"
                            required
                        >

                    </div>


                    <div class="input-group">

                        <label>Phone</label>

                        <input
                            type="tel"
                            id="phoneInput"
                            name="phone"
                            placeholder="Phone Number"
                            required
                        >

                    </div>

                </div>





                <div class="double-input">

                    <div class="input-group">

                        <label>DOB</label>

                        <input
                            type="date"
                            name="dob"
                            required
                        >

                    </div>


                    <div class="input-group">

                        <label>Gender</label>

                        <select name="gender">

                            <option>Male</option>

                            <option>Female</option>

                            <option>Other</option>

                        </select>

                    </div>

                </div>





                <div class="double-input">

                    <div class="input-group">

                        <label>Qualification</label>

                        <select name="qualification">

                            <option>10th Pass</option>

                            <option>12th Pass</option>

                            <option>Diploma</option>

                            <option>Degree</option>

                            <option>B.Tech</option>

                        </select>

                    </div>


                    <div class="input-group">

                        <label>Password</label>

                        <div class="password-wrapper">

                            <input
                                type="password"
                                id="registerPassword"
                                name="password"
                                placeholder="Password"
                                required
                            >

                            <span
                                class="password-toggle"
                                onclick="togglePassword('registerPassword')"
                            >
                                👁️
                            </span>

                        </div>


                        <div class="password-strength">

                            <div class="strength-bar">

                                <div id="strengthFill"></div>

                            </div>

                            <small id="strengthText">

                                Password Strength

                            </small>

                        </div>

                    </div>

                </div>





                <div class="double-input">

                    <div class="input-group">

                        <label>Confirm Password</label>

                        <div class="password-wrapper">

                            <input
                                type="password"
                                id="confirmPassword"
                                name="confirmpassword"
                                placeholder="Confirm Password"
                                required
                            >

                            <span
                                class="password-toggle"
                                onclick="togglePassword('confirmPassword')"
                            >
                                👁️
                            </span>

                        </div>

                        <small
                            id="passwordError"
                            class="error-message"
                        ></small>

                    </div>


                    <div class="input-group">

                        <label>Captcha</label>

                        <input
                            type="text"
                            name="captcha"
                            placeholder="Enter Captcha"
                            required
                        >

                    </div>

                </div>





                <div class="captcha-group">

                    <img
                        src="/captcha"
                        id="captcha2"
                    >

                    <button
                        type="button"
                        class="refresh-btn"
                        onclick="refreshCaptcha2()"
                    >
                        ↻
                    </button>

                </div>





                <button
                    type="submit"
                    class="submit-btn"
                    id="registerButton"
                >
                    Register
                </button>


            </form>


        </div>


    </div>


</div>





<script>


/* LOGIN TAB */

function showLogin(){

    loginForm.style.display =
    "flex";

    registerForm.style.display =
    "none";

    loginTab.classList.add(
        "active"
    );

    registerTab.classList.remove(
        "active"
    );

}



/* REGISTER TAB */

function showRegister(){

    loginForm.style.display =
    "none";

    registerForm.style.display =
    "flex";

    registerTab.classList.add(
        "active"
    );

    loginTab.classList.remove(
        "active"
    );

}



/* CAPTCHA REFRESH */

function refreshCaptcha(){

    captcha.src =
    "/captcha?" + Date.now();

}


function refreshCaptcha2(){

    captcha2.src =
    "/captcha?" + Date.now();

}



/* PASSWORD TOGGLE */

function togglePassword(id){

    const input =
    document.getElementById(id);

    input.type =
    input.type === "password"
    ? "text"
    : "password";

}



/* PASSWORD STRENGTH */

const passwordInput =
document.getElementById(
    "registerPassword"
);


passwordInput.addEventListener(

    "input",

    function(){

        const password =
        this.value;

        let strength = 0;


        if(password.length >= 8){

            strength++;

        }


        if(/[A-Z]/.test(password)){

            strength++;

        }


        if(/[0-9]/.test(password)){

            strength++;

        }


        if(/[^A-Za-z0-9]/.test(password)){

            strength++;

        }


        const fill =
        document.getElementById(
            "strengthFill"
        );


        const text =
        document.getElementById(
            "strengthText"
        );


        if(strength === 1){

            fill.style.width = "25%";

            fill.style.background =
            "#ef4444";

            text.innerText =
            "Weak Password";

        }


        else if(strength === 2){

            fill.style.width = "50%";

            fill.style.background =
            "#f59e0b";

            text.innerText =
            "Medium Password";

        }


        else if(strength === 3){

            fill.style.width = "75%";

            fill.style.background =
            "#3b82f6";

            text.innerText =
            "Strong Password";

        }


        else if(strength === 4){

            fill.style.width = "100%";

            fill.style.background =
            "#22c55e";

            text.innerText =
            "Very Strong Password";

        }


        else{

            fill.style.width = "0%";

            text.innerText =
            "Password Strength";

        }

});



/* CONFIRM PASSWORD */

const confirmPassword =
document.getElementById(
    "confirmPassword"
);


confirmPassword.addEventListener(

    "input",

    function(){

        const password =
        passwordInput.value;


        const confirm =
        this.value;


        const error =
        document.getElementById(
            "passwordError"
        );


        if(confirm === ""){

            error.innerText = "";

            this.classList.remove(
                "valid-input",
                "invalid-input"
            );

            return;

        }


        if(password === confirm){

            this.classList.add(
                "valid-input"
            );

            this.classList.remove(
                "invalid-input"
            );

            error.style.color =
            "#22c55e";

            error.innerText =
            "Passwords Match";

        }

        else{

            this.classList.add(
                "invalid-input"
            );

            this.classList.remove(
                "valid-input"
            );

            error.style.color =
            "#ef4444";

            error.innerText =
            "Passwords Do Not Match";

        }

});



/* EMAIL VALIDATION */

const emailInput =
document.getElementById(
    "emailInput"
);


emailInput.addEventListener(

    "input",

    function(){

        if(
            this.value.includes("@")
            &&
            this.value.includes(".")
        ){

            this.classList.add(
                "valid-input"
            );

            this.classList.remove(
                "invalid-input"
            );

        }

        else{

            this.classList.add(
                "invalid-input"
            );

            this.classList.remove(
                "valid-input"
            );

        }

});



/* PHONE VALIDATION */

const phoneInput =
document.getElementById(
    "phoneInput"
);


phoneInput.addEventListener(

    "input",

    function(){

        if(this.value.length >= 10){

            this.classList.add(
                "valid-input"
            );

            this.classList.remove(
                "invalid-input"
            );

        }

        else{

            this.classList.add(
                "invalid-input"
            );

            this.classList.remove(
                "valid-input"
            );

        }

});



/* FORM VALIDATION */

registerForm.addEventListener(

    "submit",

    function(e){

        if(
            passwordInput.value
            !==
            confirmPassword.value
        ){

            e.preventDefault();

            document.getElementById(
                "passwordError"
            ).innerText =
            "Passwords Do Not Match";

            return;

        }


        registerButton.classList.add(
            "loading"
        );


        registerButton.innerText =
        "Registering...";

});

</script>


</body>

</html>